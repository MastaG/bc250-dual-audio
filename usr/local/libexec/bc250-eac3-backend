#!/usr/bin/env bash
# BC-250 realtime E-AC-3 / Dolby Digital Plus backend.
#
# v0.10 handshake:
#   WirePlumber -> bc250.eac3.permit   : EAC3 transition is committed
#   helper      -> bc250.eac3.session  : helper session is attached / may own HDMI
#   helper      -> bc250.eac3.hardware : diagnostic; ffmpeg/aplay may own HDMI
#
# The helper never opens HDMI until the permit metadata exists. During teardown
# WirePlumber clears the permit, unloads the FIFO backend and waits for SESSION
# to disappear before another owner may claim hw:Generic,3.
set -u -o pipefail

RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
FIFO=${BC250_EAC3_FIFO:-$RUNTIME_DIR/bc250-eac3-768.pcm}
PREBUFFER=$RUNTIME_DIR/bc250-eac3-768.prebuffer.$$
FRAME_BYTES=$((1536 * 6 * 4))  # one 32 ms E-AC-3 frame: F32LE, 48 kHz, 5.1
HDMI_DEVICE=${BC250_EAC3_ALSA_DEVICE:-hdmi:CARD=Generic,DEV=0,AES0=0x06}
METADATA_NAME=${BC250_EAC3_METADATA_NAME:-default}
PERMIT_KEY=${BC250_EAC3_PERMIT_KEY:-bc250.eac3.permit}
SESSION_KEY=${BC250_EAC3_SESSION_KEY:-bc250.eac3.session}
HARDWARE_KEY=${BC250_EAC3_HARDWARE_KEY:-bc250.eac3.hardware}
PIPELINE_POLL_SEC=${BC250_EAC3_PIPELINE_POLL_SEC:-0.02}
PIPELINE_TERM_LOOPS=${BC250_EAC3_PIPELINE_TERM_LOOPS:-25} # ~500 ms at default poll
PERMIT_POLL_SEC=${BC250_EAC3_PERMIT_POLL_SEC:-0.02}

PIPELINE_PID=""

log() {
    printf '%s\n' "bc250-eac3-backend: $*" >&2
}

metadata_set() {
    local key=$1 value=$2
    pw-metadata -n "$METADATA_NAME" 0 "$key" "$value" >/dev/null 2>&1
}

metadata_clear() {
    local key=$1
    pw-metadata -n "$METADATA_NAME" --delete 0 "$key" >/dev/null 2>&1 || true
}

metadata_present() {
    local key=$1
    pw-metadata -n "$METADATA_NAME" 0 "$key" 2>/dev/null | grep -Fq "key:'$key'"
}

pipeline_running() {
    [[ -n "$PIPELINE_PID" ]] && kill -0 "$PIPELINE_PID" 2>/dev/null
}

stop_pipeline() {
    local reason=${1:-requested}
    local i

    if ! pipeline_running; then
        PIPELINE_PID=""
        metadata_clear "$HARDWARE_KEY"
        return 0
    fi

    log "stopping E-AC-3 pipeline ($reason)"

    # setsid makes the wrapper the process-group leader. Terminating the group
    # stops the PCM feeder, ffmpeg and aplay as one ownership unit.
    kill -TERM -- "-$PIPELINE_PID" 2>/dev/null || kill -TERM "$PIPELINE_PID" 2>/dev/null || true

    for ((i = 0; i < PIPELINE_TERM_LOOPS; i++)); do
        pipeline_running || break
        sleep "$PIPELINE_POLL_SEC"
    done

    if pipeline_running; then
        log "pipeline did not stop after TERM; sending KILL"
        kill -KILL -- "-$PIPELINE_PID" 2>/dev/null || kill -KILL "$PIPELINE_PID" 2>/dev/null || true
    fi

    wait "$PIPELINE_PID" 2>/dev/null || true
    PIPELINE_PID=""
    metadata_clear "$HARDWARE_KEY"
}

close_session() {
    exec 3<&- || true
    metadata_clear "$HARDWARE_KEY"
    metadata_clear "$SESSION_KEY"
    rm -f -- "$PREBUFFER"
}

cleanup() {
    stop_pipeline "service shutdown"
    close_session
}
trap cleanup EXIT
trap 'exit 0' INT TERM HUP

for cmd in ffmpeg aplay pw-metadata mkfifo dd cat grep tr stat setsid rm sleep; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        log "required command not found: $cmd"
        exit 127
    fi
done

umask 077
metadata_clear "$SESSION_KEY"
metadata_clear "$HARDWARE_KEY"
rm -f -- "$PREBUFFER"

# pipe-tunnel may unlink the FIFO pathname on every EAC3 backend unload. Rebuild
# it for the next writer rather than assuming the pathname persists.
ensure_fifo() {
    if [[ -e "$FIFO" && ! -p "$FIFO" ]]; then
        log "removing non-FIFO path: $FIFO"
        rm -f -- "$FIFO" || return 1
    fi

    if [[ ! -p "$FIFO" ]]; then
        if ! mkfifo -m 0600 "$FIFO"; then
            log "failed to create FIFO: $FIFO"
            return 1
        fi
    fi

    return 0
}

find_generic_card_dir() {
    local id
    for id in /proc/asound/card*/id; do
        [[ -r "$id" ]] || continue
        if [[ $(tr -d '\n' < "$id") == "Generic" ]]; then
            printf '%s\n' "${id%/id}"
            return 0
        fi
    done
    return 1
}

eld_supports_eac3() {
    [[ ${BC250_EAC3_IGNORE_ELD:-0} == 1 ]] && return 0

    local card_dir eld
    card_dir=$(find_generic_card_dir) || return 1

    for eld in "$card_dir"/eld#*; do
        [[ -r "$eld" ]] || continue
        grep -Eq '^[[:space:]]*monitor_present[[:space:]]+1' "$eld" || continue
        grep -Eq '^[[:space:]]*eld_valid[[:space:]]+1' "$eld" || continue
        if grep -Eiq 'coding_type.*(E-AC-3|EAC3|DD\+|Dolby Digital Plus)' "$eld"; then
            return 0
        fi
    done
    return 1
}

wait_for_permit_or_cancel() {
    while ! metadata_present "$PERMIT_KEY"; do
        # A cancelled transition unloads the pipe backend and removes the FIFO
        # pathname. In that case no stale ffmpeg/aplay open is allowed.
        if [[ ! -p "$FIFO" ]]; then
            return 1
        fi
        sleep "$PERMIT_POLL_SEC"
    done
    return 0
}

start_pipeline() {
    metadata_set "$HARDWARE_KEY" "$$" || {
        log "failed to publish EAC3 hardware-active metadata"
        return 1
    }

    export BC250_EAC3_CHILD_PREBUFFER="$PREBUFFER"
    export BC250_EAC3_CHILD_FRAME_BYTES="$FRAME_BYTES"
    export BC250_EAC3_CHILD_HDMI_DEVICE="$HDMI_DEVICE"

    # Read only complete EAC3-frame-sized PCM blocks after the prebuffer.
    # conv=sync pads a final short EOF block instead of exposing a 16-byte
    # partial 5.1 F32LE sample to FFmpeg during teardown.
    setsid bash -c '
        {
            cat "$BC250_EAC3_CHILD_PREBUFFER"
            dd iflag=fullblock bs="$BC250_EAC3_CHILD_FRAME_BYTES" conv=sync status=none <&3
        } | ffmpeg \
            -nostdin -hide_banner -loglevel warning \
            -f f32le -ar 48000 -ac 6 -i pipe:0 \
            -filter:a "pan=5.1|FL=c0|FR=c1|FC=c4|LFE=c5|BL=c2|BR=c3" \
            -c:a eac3 -b:a 768k -ar 48000 -ac 6 \
            -flush_packets 1 -f spdif pipe:1 | \
            aplay -q -D "$BC250_EAC3_CHILD_HDMI_DEVICE" -t raw -f S16_LE -c 2 -r 192000
    ' &
    PIPELINE_PID=$!

    if ! pipeline_running; then
        wait "$PIPELINE_PID" 2>/dev/null || true
        PIPELINE_PID=""
        metadata_clear "$HARDWARE_KEY"
        return 1
    fi

    return 0
}

log "ready; waiting for $FIFO"

while true; do
    close_session

    if ! ensure_fifo; then
        sleep 1
        continue
    fi

    # Block until PipeWire's pipe-tunnel writer attaches.
    if ! exec 3<"$FIFO"; then
        log "failed to open FIFO for reading: $FIFO"
        sleep 0.1
        continue
    fi

    # SESSION is the helper -> WirePlumber release acknowledgement. Publish it
    # before any path can reach a hardware open.
    if ! metadata_set "$SESSION_KEY" "$$"; then
        log "failed to publish EAC3 session metadata"
        exec 3<&-
        sleep 0.1
        continue
    fi

    rm -f -- "$PREBUFFER"

    dd iflag=fullblock bs="$FRAME_BYTES" count=1 status=none <&3 >"$PREBUFFER" || true
    prebuffer_bytes=$(stat -c %s "$PREBUFFER" 2>/dev/null || printf '0')
    if [[ "$prebuffer_bytes" != "$FRAME_BYTES" ]]; then
        close_session
        continue
    fi

    if ! eld_supports_eac3; then
        log "connected sink ELD does not advertise E-AC-3/DD+; discarding E-AC-3 mode PCM"
        cat <&3 >/dev/null || true
        close_session
        continue
    fi

    # The bridge can already feed the FIFO at this point, but the final
    # WirePlumber generation check has not necessarily committed the mode yet.
    # Do not open HDMI until the explicit permit metadata appears.
    if ! wait_for_permit_or_cancel; then
        close_session
        continue
    fi

    # Fresh query immediately before launch closes the cancelled-start race.
    if ! metadata_present "$PERMIT_KEY" || [[ ! -p "$FIFO" ]]; then
        close_session
        continue
    fi

    log "starting E-AC-3 5.1 @ 768 kbps -> IEC61937 -> $HDMI_DEVICE"

    if ! start_pipeline; then
        log "failed to start E-AC-3 pipeline"
        close_session
        sleep 0.1
        continue
    fi

    stop_reason="pipeline exited"
    while pipeline_running; do
        # pipe-tunnel unlink is the active teardown signal. WirePlumber clears
        # PERMIT before doing this, then waits for SESSION to disappear.
        if [[ ! -p "$FIFO" ]]; then
            stop_reason="PipeWire FIFO backend disappeared"
            break
        fi
        sleep "$PIPELINE_POLL_SEC"
    done

    if pipeline_running; then
        stop_pipeline "$stop_reason"
    else
        wait "$PIPELINE_PID" 2>/dev/null || true
        PIPELINE_PID=""
        metadata_clear "$HARDWARE_KEY"
        log "pipeline exited"
    fi

    # SESSION is cleared only after the whole process group, including aplay,
    # has been reaped. WirePlumber may start its release guard only after this.
    close_session
    log "hardware release acknowledged"
done
